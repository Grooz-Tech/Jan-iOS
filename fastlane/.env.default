MATCH_GIT_URL=__CERTS_REPO_URL__

FL_REGISTER_DEVICES_FILE=fastlane/devices.txt

GYM_WORKSPACE=__APP_NAME__.xcworkspace
GYM_SCHEME=__APP_NAME__
