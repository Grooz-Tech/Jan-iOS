FASTLANE_SKIP_UPDATE_CHECK=1
FASTLANE_SKIP_DOCS=1

PRODUCE_APP_IDENTIFIER=__BUNDLE_ID__
MATCH_APP_IDENTIFIER=__BUNDLE_ID__
FASTLANE_TEAM_ID=__TEAM_ID__
PRODUCE_APP_NAME=__APP_NAME__
PRODUCE_USERNAME=__APPLE_ID__

APP_STORE_CONNECT_API_KEY_KEY_ID=__ASC_KEY_ID__
APP_STORE_CONNECT_API_KEY_ISSUER_ID=__ASC_ISSUER_ID__
